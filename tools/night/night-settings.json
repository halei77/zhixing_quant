{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python:*)",
      "Bash(python:*)",
      "Bash(uv run zx-task:*)",
      "Bash(.venv/bin/zx-task:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git push --delete:*)",
      "Bash(tools/publish_site.sh:*)",
      "Bash(./tools/publish_site.sh:*)"
    ]
  }
}

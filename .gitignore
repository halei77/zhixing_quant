.qoder/settings.local.json

# Python 虚拟环境与缓存（02 §1：uv.lock 必须入库，其余产物不入库）
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.json
htmlcov/
dist/
*.egg-info/

# 密钥与凭据（02 §4：仓库只放 .env.example）
.env
.env.*
!.env.example

# 站点 e2e（tools/e2e/）
tools/e2e/node_modules/
tools/e2e/test-results/
